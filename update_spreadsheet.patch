  // Calculate Totals
  const processedStudents = useMemo(() => {
    return students.map(student => {
      // 1. Gather all included sessions and normalize their scores to percentages first
      // This is crucial because a 10/10 is better than a 20/50. We need to compare normalized weights.
      const includedScores = sessions
        .filter(s => s.includeInCalculation)
        .map(s => {
            const rawScore = student.scores[s.id] || 0;
            const maxMarks = s.totalMarks || 100;
            const percentage = maxMarks > 0 ? (rawScore / maxMarks) * 100 : 0;
            return { rawScore, maxMarks, percentage, id: s.id };
        });

      // 2. Sort by percentage (highest first) to apply the Drop Rule
      includedScores.sort((a, b) => b.percentage - a.percentage);

      // 3. Apply Drop Rule (Keep best X)
      // If dropRuleCount > 0 and we have more assessments than the dropRuleCount,
      // we take the top `dropRuleCount` assessments.
      // Otherwise, we take all included assessments.
      const sessionsToKeep = dropRuleCount > 0 && dropRuleCount < includedScores.length
          ? includedScores.slice(0, dropRuleCount)
          : includedScores;

      // 4. Calculate raw total and max possible for the *kept* sessions
      let totalScore = 0;
      let possibleMax = 0;

      sessionsToKeep.forEach(s => {
          totalScore += s.rawScore;
          possibleMax += s.maxMarks;
      });

      // 5. Calculate final percentage based on kept sessions
      const percentage = possibleMax > 0 ? (totalScore / possibleMax) * 100 : 0;

      // 6. Scale Final Score
      const scaledScore = scaleTo > 0 ? (percentage / 100) * scaleTo : percentage;

      return {
        ...student,
        totalScore,
        percentage,
        scaledScore,
        keptSessions: sessionsToKeep.map(s => s.id)
      };
    }).sort((a, b) => (b.percentage || 0) - (a.percentage || 0)); // Rank by percentage
  }, [students, sessions, dropRuleCount, scaleTo]);
