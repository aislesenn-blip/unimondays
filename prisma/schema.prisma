generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id // Clerk ID
  email     String   @unique
  name      String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes   Class[]  @relation("LecturerClasses")
  enrollments Enrollment[]
  rubrics   Rubric[]
  submissions Submission[]
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

model Class {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // Optional: human-readable class code
  lecturerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lecturer    User     @relation("LecturerClasses", fields: [lecturerId], references: [id])
  sessions    WorkSession[]
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}

model Rubric {
  id               String   @id @default(cuid())
  lecturerId       String
  name             String
  originalPdfUrl   String?
  standardizedJson Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lecturer         User     @relation(fields: [lecturerId], references: [id])
  sessions         WorkSession[]
}

model WorkSession {
  id        String   @id @default(cuid())
  classId   String
  rubricId  String
  title     String
  workCode  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class    @relation(fields: [classId], references: [id])
  rubric    Rubric   @relation(fields: [rubricId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String   @id @default(cuid())
  studentId     String
  workSessionId String
  pdfUrl        String
  status        SubmissionStatus @default(PROCESSING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workSession   WorkSession @relation(fields: [workSessionId], references: [id])
  student       User     @relation(fields: [studentId], references: [id])
  score         Score?
}

enum SubmissionStatus {
  PROCESSING
  GRADED
  FAILED
}

model Score {
  id           String   @id @default(cuid())
  submissionId String   @unique
  totalScore   Float
  breakdown    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission   Submission @relation(fields: [submissionId], references: [id])
}
