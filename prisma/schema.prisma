datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  fullName        String?
  institutionName String?
  isAdmin         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdClasses  Class[]        @relation("LecturerClasses")
  enrollments     Enrollment[]
  submissions     Submission[]
  createdRubrics  Rubric[]
}

model Class {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  lecturerId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lecturer    User          @relation("LecturerClasses", fields: [lecturerId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  workSessions WorkSession[]

  @@index([lecturerId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  createdAt DateTime @default(now())

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

enum WorkSessionStatus {
  DRAFT
  PUBLISHED
  GRADING
  COMPLETED
  ARCHIVED
}

enum ReleaseMode {
  MANUAL
  IMMEDIATE
  ON_DEADLINE
}

model WorkSession {
  id                  String              @id @default(cuid())
  title               String
  classId             String
  lecturerId          String 
  workCode            String              @unique @default(cuid()) 
  status              WorkSessionStatus   @default(DRAFT)
  releaseMode         ReleaseMode         @default(MANUAL)
  deadline            DateTime?
  appealDeadline      DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  class               Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  rubric              Rubric?             @relation(fields: [rubricId], references: [id])
  rubricId            String?             @unique
  submissions         Submission[]

  @@index([classId])
  @@index([lecturerId])
}

model Rubric {
  id                String       @id @default(cuid())
  name              String
  creatorId         String
  rawText           String?      @db.Text
  standardizedJson  Json?
  maxScore          Int?
  isPublic          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  creator           User         @relation(fields: [creatorId], references: [id])
  workSession       WorkSession? 

  @@index([creatorId])
}

enum SubmissionStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  GRADED
  APPEAL_REQUESTED
  APPEAL_RESOLVED
  FLAGGED
}

model Submission {
  id              String              @id @default(cuid())
  studentId       String
  workSessionId   String
  fileUrl         String?             @db.Text
  status          SubmissionStatus    @default(PENDING_UPLOAD)
  submittedAt     DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  student         User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workSession     WorkSession         @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  score           Score?              
  appeals         Appeal[]
  auditTrail      AuditEntry[]

  @@unique([studentId, workSessionId])
  @@index([workSessionId])
}

model Score {
  id              String      @id @default(cuid())
  submissionId    String      @unique
  score           Float
  breakdown       Json?       
  graderNotes     String?     @db.Text
  isFinal         Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

enum AppealStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

model Appeal {
  id              String        @id @default(cuid())
  submissionId    String
  reason          String        @db.Text
  status          AppealStatus  @default(PENDING)
  resolutionNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  submission      Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model AuditEntry {
  id              String    @id @default(cuid())
  submissionId    String
  actor           String    
  action          String    
  details         Json?     
  timestamp       DateTime  @default(now())

  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
