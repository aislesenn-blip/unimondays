// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  domain    String?  // e.g. "uon.ac.ke" for auto-join
  code      String   @unique // e.g. "UON"

  users     User[]
  classes   Classes[]
  jobs      Job[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  // For local dev auth
  fullName  String?
  institution String? // Legacy? Keep for text.

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  role      String   // 'lecturer', 'student', 'admin', 'moderator'
  tier      String   @default("Lite") // 'Lite', 'Pro', 'X'
  quota     Int      @default(100) // Script quota
  used      Int      @default(0)   // Used scripts this month
  createdAt DateTime @default(now())
  deletedAt DateTime? // Soft delete

  classes   Classes[]
  quizzes   Quiz[]
  enrollments StudentEnrollment[]
  groups    GroupMember[]
  submissions Submission[]
  calibration LecturerCalibration?

  @@index([universityId])
}

// Renaming Classes to Session conceptually, but keeping table name for now.
model Classes {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  lecturerId Int
  lecturer  User     @relation(fields: [lecturerId], references: [id])

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  status    String   @default("ACTIVE") // DRAFT, ACTIVE, LOCKED, ARCHIVED
  semester  String?
  mode      String?  // ONLINE, OFFLINE, HYBRID

  students  String? // Deprecated JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  quizzes   Quiz[]
  enrollments StudentEnrollment[]
  groupSets GroupSet[]

  @@index([universityId])
}

model StudentEnrollment {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Classes  @relation(fields: [classId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("ACTIVE") // ACTIVE, DROPPED

  joinedAt  DateTime @default(now())
  deletedAt DateTime? // Soft delete

  @@unique([userId, classId])
  @@index([classId])
}

model GroupSet {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Classes  @relation(fields: [classId], references: [id])
  name      String   // e.g. "Lab Partners"

  groups    Group[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Group {
  id        Int      @id @default(autoincrement())
  setId     Int
  set       GroupSet @relation(fields: [setId], references: [id])
  name      String   // e.g. "Group A"

  members   GroupMember[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

model Quiz {
  id        Int      @id @default(autoincrement())
  title     String
  code      String   @unique
  lecturerId Int
  lecturer  User     @relation(fields: [lecturerId], references: [id])
  classId   Int?
  class     Classes? @relation(fields: [classId], references: [id])

  deadline  DateTime?
  timer     Int?     // Minutes per student
  mode      String?  // 'ONLINE', 'UPLOAD', 'HYBRID'
  isUpload  Boolean  @default(true) // Legacy support
  rubric    String?  // Grading Rubric text
  gradingConfig String? // JSON: { strictness, language, etc. }

  // Production Hardening
  markingScheme String? // Text or path to marking scheme
  strictness    String? // 'LENIENT', 'MODERATE', 'STRICT'

  status    String   @default("DRAFT") // DRAFT, PUBLISHED, GRADING, RELEASED
  weight    Int      @default(0) // Basis points (e.g. 1000 = 10.00%)
  totalMarks Int?    // Immutable after publish

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  submissions Submission[]

  @@index([code])
}

model Submission {
  id        Int      @id @default(autoincrement())
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id])

  studentRegNo String // Legacy/Fallback
  studentName  String? // Legacy/Fallback

  // Link to real User if enrolled
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])

  filePath     String? // Path to PDF/Image (Absolute or relative to storage root)
  ocrText      String? // Extracted Text
  status       String  @default("PENDING") // PENDING, PENDING_OCR, SUBMITTED, PROCESSING, GRADED, FLAGGED, LATE, MISSING

  feedback        String? // JSON structured feedback
  confidenceScore Float?
  calibrationId   Int? // Link to used calibration

  submittedAt  DateTime @default(now())

  // Group Hardening
  groupId      Int?     // If group work
  groupSnapshot String? // JSON string of group member IDs at time of submission

  score     Score?
  audit     AuditLog[]
  appeals   Appeals[]

  deletedAt DateTime? // Soft delete

  @@unique([quizId, userId]) // Constraint: One submission per student per quiz
  @@index([quizId])
  @@index([status])
}

model Score {
  id           Int        @id @default(autoincrement())
  submissionId Int        @unique
  submission   Submission @relation(fields: [submissionId], references: [id])

  totalMarks   Float
  breakdown    String     // JSON string of question breakdown
  rubricMap    String?    // JSON string: how rubric was applied
  remarks      String?
  confidence   Float?

  isOverridden Boolean    @default(false)

  gradedAt     DateTime   @default(now())

  @@index([submissionId])
}

model AuditLog {
  id           Int        @id @default(autoincrement())

  submissionId Int?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  action       String     // 'OCR', 'Grading', 'Flag', 'Access', 'Login'
  details      String?

  // Security
  ipAddress    String?
  userAgent    String?
  severity     String?    // 'INFO', 'WARN', 'CRITICAL'

  timestamp    DateTime   @default(now())

  @@index([universityId])
}

model Appeals {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  reason       String
  status       String     @default("OPEN")
  response     String?
}

model QuizCode {
  id     Int    @id @default(autoincrement())
  code   String @unique
  quizId Int
}

model Job {
  id        String   @id @default(cuid())
  type      String   // 'OCR_SPLIT', 'AI_GRADE', 'EXPORT_ZIP'
  data      String   // JSON payload
  status    String   // 'PENDING', 'PROCESSING', 'COMPLETED', 'FAILED'
  result    String?  // JSON result
  error     String?
  attempts  Int      @default(0)
  priority  Int      @default(0)

  quizId    Int? // Optional Link

  // Tenant Isolation
  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  processedAt DateTime?

  @@index([status, priority])
  @@index([type])
  @@index([universityId])
}

model LecturerCalibration {
  id         Int      @id @default(autoincrement())
  lecturerId Int      @unique
  lecturer   User     @relation(fields: [lecturerId], references: [id])

  strictness Float    @default(1.0) // Multiplier
  notes      String?  // JSON: specific biases

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
