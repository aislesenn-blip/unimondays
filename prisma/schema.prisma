// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ENUMS (SQLite doesn't support enums natively, handled by Prisma)

// 2. UNIVERSITIES (Deleted)

// 3. USERS
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String?   @map("full_name")
  role         String    @default("STUDENT") // UserRole enum
  tier         String?   @default("Lite")
  quota        Int?      @default(100)
  used         Int?      @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  classes      Classes[] // As lecturer
  workSessions WorkSession[] // As lecturer
  submissions  Submission[]
  auditLogs    AuditLog[]

  @@map("users")
}

// 4. CLASSES
model Classes {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  lecturerId   String    @map("lecturer_id")
  status       String?   @default("ACTIVE")
  semester     String?
  mode         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  lecturer     User       @relation(fields: [lecturerId], references: [id])
  workSessions WorkSession[]

  @@map("classes")
}

// 5. WORK SESSIONS (ex-QUIZZES)
model WorkSession {
  id           String    @id @default(uuid())
  title        String
  workCode     String    @unique @map("work_code")
  lecturerId   String    @map("lecturer_id")
  classId      String?   @map("class_id")
  deadline     DateTime?
  status       String?   @default("DRAFT")
  rubric       String?
  rubricUrl    String?   @map("rubric_url")
  markingScheme String?  @map("marking_scheme")
  instructions String?
  strictness   String?   // 'LENIENT', 'MODERATE', 'STRICT'
  totalMarks   Int?      @map("total_marks")
  releaseMode  String?   @default("MANUAL") @map("release_mode")
  type         String?   @default("WORK_SESSION")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  lecturer     User       @relation(fields: [lecturerId], references: [id])
  class        Classes?   @relation(fields: [classId], references: [id])
  submissions  Submission[]

  @@map("work_sessions")
}

// 6. SUBMISSIONS
model Submission {
  id             String           @id @default(uuid())
  workSessionId  String           @map("work_session_id")
  userId         String?          @map("user_id")
  studentRegNo   String?          @map("student_reg_no")
  studentName    String?          @map("student_name")
  filePath       String?          @map("file_path")
  ocrText        String?          @map("ocr_text")
  status         String @default("PENDING") // SubmissionStatus enum
  feedback       String? // Stored as string
  confidenceScore Float?          @map("confidence_score")
  submittedAt    DateTime?        @default(now()) @map("submitted_at")
  deletedAt      DateTime?        @map("deleted_at")
  workSession  WorkSession @relation(fields: [workSessionId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  score        Score?
  appeals      Appeal[]

  // Unique constraint on workSessionId + userId
  @@unique([workSessionId, userId])

  @@map("submissions")
  @@index([workSessionId])
}

// 7. SCORES
model Score {
  id           String    @id @default(uuid())
  submissionId String    @unique @map("submission_id")
  totalMarks   Float     @map("total_marks")
  breakdown    String    @map("breakdown") // Stored as string
  remarks      String?
  isOverridden Boolean?  @default(false) @map("is_overridden")
  gradedAt     DateTime? @default(now()) @map("graded_at")

  submission   Submission @relation(fields: [submissionId], references: [id])

  @@map("scores")
}

// 8. JOBS
model Job {
  id           String    @id @default(uuid())
  type         String // JobType enum
  payload      String      @map("payload") // Stored as string
  status       String @default("PENDING") // JobStatus enum
  result       String?     @map("result") // Stored as string
  error        String?
  retryCount   Int?      @default(0) @map("retry_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  processedAt  DateTime? @map("processed_at")

  @@map("jobs")
  @@index([status, type])
}

// 9. AUDIT LOGS
model AuditLog {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  action       String
  details      String?
  ipAddress    String?   @map("ip_address")
  severity     String?   @default("INFO")
  timestamp    DateTime? @default(now())

  user         User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// 10. APPEALS
model Appeal {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComment String?  @map("admin_comment")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  submission   Submission @relation(fields: [submissionId], references: [id])

  @@map("appeals")
  @@index([submissionId])
}
