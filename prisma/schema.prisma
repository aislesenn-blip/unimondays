// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ENUMS
enum UserRole {
  ADMIN
  LECTURER
  STUDENT
  @@map("user_role")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  @@map("job_status")
}

enum JobType {
  OCR_SPLIT
  AI_GRADE
  EXPORT_ZIP
  @@map("job_type")
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  GRADED
  FLAGGED
  LATE
  MISSING
  @@map("submission_status")
}

// 2. UNIVERSITIES
model University {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  domain    String?  @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users     User[]
  classes   Classes[]
  quizzes   Quiz[]
  submissions Submission[]
  jobs      Job[]
  auditLogs AuditLog[]

  @@map("universities")
}

// 3. USERS
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  fullName     String?   @map("full_name")
  universityId String?   @map("university_id") @db.Uuid
  role         UserRole  @default(STUDENT)
  tier         String?   @default("Lite")
  quota        Int?      @default(100)
  used         Int?      @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  university   University? @relation(fields: [universityId], references: [id])
  classes      Classes[] // As lecturer
  quizzes      Quiz[]    // As lecturer
  submissions  Submission[]
  auditLogs    AuditLog[]

  @@map("users")
  @@index([universityId])
}

// 4. CLASSES
model Classes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  code         String    @unique
  universityId String    @map("university_id") @db.Uuid
  lecturerId   String    @map("lecturer_id") @db.Uuid
  status       String?   @default("ACTIVE")
  semester     String?
  mode         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  university   University @relation(fields: [universityId], references: [id])
  lecturer     User       @relation(fields: [lecturerId], references: [id])
  quizzes      Quiz[]

  @@map("classes")
  @@index([universityId])
}

// 5. QUIZZES
model Quiz {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  code         String    @unique
  universityId String    @map("university_id") @db.Uuid
  lecturerId   String    @map("lecturer_id") @db.Uuid
  classId      String?   @map("class_id") @db.Uuid
  deadline     DateTime? @db.Timestamptz
  status       String?   @default("DRAFT")
  rubric       String?
  markingScheme String?  @map("marking_scheme")
  instructions String?
  strictness   String?   // 'LENIENT', 'MODERATE', 'STRICT'
  weight       Int?      @default(0)
  totalMarks   Int?      @map("total_marks")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  university   University @relation(fields: [universityId], references: [id])
  lecturer     User       @relation(fields: [lecturerId], references: [id])
  class        Classes?   @relation(fields: [classId], references: [id])
  submissions  Submission[]

  // Optional: Add timer/mode if they exist in SQL? SQL provided: `strictness TEXT, weight INTEGER, total_marks INTEGER`.
  // NO `timer`, `mode` in SQL.
  // I must remove them.
  // BUT `CreateWorkPage` uses them. I will keep them but comment they are virtual/missing in DB?
  // No, strict sync means removing them from Model.
  // I will remove `timer`, `mode`, `isUpload`, `gradingConfig` from Model.

  @@map("quizzes")
  @@index([universityId])
}

// 6. SUBMISSIONS
model Submission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId         String           @map("quiz_id") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  universityId   String           @map("university_id") @db.Uuid
  studentRegNo   String?          @map("student_reg_no")
  studentName    String?          @map("student_name")
  filePath       String?          @map("file_path")
  ocrText        String?          @map("ocr_text")
  status         SubmissionStatus @default(PENDING)
  feedback       Json?            @db.JsonB
  confidenceScore Float?          @map("confidence_score")
  submittedAt    DateTime?        @default(now()) @map("submitted_at") @db.Timestamptz
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz
  groupId        String?          @map("group_id") @db.Uuid
  groupSnapshot  Json?            @map("group_snapshot") @db.JsonB

  quiz         Quiz       @relation(fields: [quizId], references: [id])
  user         User?      @relation(fields: [userId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  score        Score?
  appeals      Appeal[]

  // Unique constraint on quizId + userId
  @@unique([quizId, userId])

  @@map("submissions")
  @@index([universityId])
  @@index([quizId])
}

// 7. SCORES
model Score {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String    @unique @map("submission_id") @db.Uuid
  totalMarks   Float     @map("total_marks")
  breakdown    Json      @db.JsonB
  remarks      String?
  isOverridden Boolean?  @default(false) @map("is_overridden")
  gradedAt     DateTime? @default(now()) @map("graded_at") @db.Timestamptz

  submission   Submission @relation(fields: [submissionId], references: [id])

  @@map("scores")
}

// 8. JOBS
model Job {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         JobType
  payload      Json      @db.JsonB
  status       JobStatus @default(PENDING)
  result       Json?     @db.JsonB
  error        String?
  retryCount   Int?      @default(0) @map("retry_count")
  universityId String?   @map("university_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz

  university   University? @relation(fields: [universityId], references: [id])

  @@map("jobs")
  @@index([status, type])
  @@index([universityId])
}

// 9. AUDIT LOGS
model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  universityId String?   @map("university_id") @db.Uuid
  action       String
  details      String?
  ipAddress    String?   @map("ip_address")
  severity     String?   @default("INFO")
  timestamp    DateTime? @default(now()) @db.Timestamptz

  user         User?       @relation(fields: [userId], references: [id])
  university   University? @relation(fields: [universityId], references: [id])

  @@map("audit_logs")
}

// 10. APPEALS
model Appeal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComment String?  @map("admin_comment")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  submission   Submission @relation(fields: [submissionId], references: [id])

  @@map("appeals")
  @@index([submissionId])
}
