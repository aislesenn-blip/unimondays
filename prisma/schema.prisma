
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["dataProxy"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

// App-level Enums. DB uses TEXT.
enum GradingStatus {
  PENDING
  MAPPING
  GRADING
  REDUCING
  COMPLETED
  FAILED
}

enum JobType {
  MAP_SUBMISSION
  CHILD_TASK_OCR
  CHILD_TASK_GRADE_CHUNK
  CHILD_TASK_IDENTIFY_STUDENT
  REDUCE_GRADES
  PROCESS_BULK_SESSION
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  WAITING_FOR_CHILDREN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  fullName            String?   @map("full_name")
  role                String    @default("STUDENT")
  tier                String?   @default("Lite")
  quota               Int?      @default(100)
  used                Int?      @default(0)
  calibrationSettings String?   @map("calibration_settings")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  classes             Classes[]
  workSessions        WorkSession[]
  submissions         Submission[]
  auditLogs           AuditLog[]
  bulkSessions        BulkSession[]
  standardizedRubrics StandardizedRubric[]

  @@index([email])
  @@map("users")
}

model Classes {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  lecturerId String    @map("lecturer_id")
  status     String?   @default("ACTIVE")
  semester   String?
  mode       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  lecturer     User          @relation(fields: [lecturerId], references: [id])
  workSessions WorkSession[]

  @@index([lecturerId])
  @@map("classes")
}

model WorkSession {
  id                   String    @id @default(uuid())
  title                String
  workCode             String    @unique @map("work_code")
  lecturerId           String    @map("lecturer_id")
  classId              String?   @map("class_id")
  deadline             DateTime?
  status               String?   @default("DRAFT")
  rubric               String?
  rubricUrl            String?   @map("rubric_url")
  markingScheme        String?   @map("marking_scheme")
  goldStandardUrl      String?   @map("gold_standard_url")
  questionPaperUrl     String?   @map("question_paper_url")
  instructions         String?
  calibration          String?
  strictness           String?
  totalMarks           Int?      @map("total_marks")
  releaseMode          String?   @default("MANUAL") @map("release_mode")
  bulkSessionId        String?   @map("bulk_session_id")
  standardizedRubricId String?   @map("standardized_rubric_id")
  strictDeadline       Boolean?  @default(false) @map("strict_deadline")
  areGradesReleased    Boolean?  @default(false) @map("are_grades_released")
  includeInCalculation Boolean?  @default(true) @map("include_in_calculation")
  allowAppeals         Boolean?  @default(false) @map("allow_appeals")
  appealDeadline       DateTime? @map("appeal_deadline")
  confidenceThreshold  Int?      @default(85) @map("confidence_threshold")
  type                 String?   @default("WORK_SESSION")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  lecturer           User                @relation(fields: [lecturerId], references: [id])
  class              Classes?            @relation(fields: [classId], references: [id])
  submissions        Submission[]
  bulkSession        BulkSession?        @relation(fields: [bulkSessionId], references: [id])
  standardizedRubric StandardizedRubric? @relation(fields: [standardizedRubricId], references: [id])

  @@index([classId])
  @@index([lecturerId])
  @@index([bulkSessionId])
  @@index([standardizedRubricId])
  @@map("work_sessions")
}

model Submission {
  id              String    @id @default(uuid())
  workSessionId   String    @map("work_session_id")
  userId          String?   @map("user_id")
  studentRegNo    String?   @map("student_reg_no")
  studentName     String?   @map("student_name")
  filePath        String?   @map("file_path")
  ocrText         String?   @map("ocr_text")
  status          String    @default("PENDING")
  gradingStatus   String?   @map("grading_status")
  feedback        String?
  confidenceScore Float?    @map("confidence_score")
  submittedAt     DateTime? @default(now()) @map("submitted_at")
  deletedAt       DateTime? @map("deleted_at")

  workSession WorkSession @relation(fields: [workSessionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  score       Score?
  appeals     Appeal[]
  jobs        Job[]

  @@unique([workSessionId, userId])
  @@index([workSessionId])
  @@index([userId])
  @@index([status])
  @@index([studentRegNo])
  @@map("submissions")
}

model Score {
  id               String    @id @default(uuid())
  submissionId     String    @unique @map("submission_id")
  totalMarks       Float     @map("total_marks")
  breakdown        String    @map("breakdown")
  remarks          String?
  studentRemarks   String?   @map("student_remarks")
  teacherRemarks   String?   @map("teacher_remarks")
  detectedIdentity String?   @map("detected_identity")
  isOverridden     Boolean?  @default(false) @map("is_overridden")
  gradedAt         DateTime? @default(now()) @map("graded_at")

  submission     Submission             @relation(fields: [submissionId], references: [id])
  conceptResults StudentConceptResult[]

  @@map("scores")
}

model StudentConceptResult {
  id           String @id @default(uuid())
  scoreId      String @map("score_id")
  conceptId    String @map("concept_id")
  status       String
  awardedMarks Float  @map("awarded_marks")
  reasoning    String

  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@map("student_concept_results")
}

model Job {
  id             String    @id @default(uuid())
  type           String
  payload        String
  status         String    @default("PENDING")
  result         String?
  error          String?
  retryCount     Int?      @default(0) @map("retry_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  processedAt    DateTime? @map("processed_at")
  parentId       String?   @map("parent_id")
  submissionId   String?   @map("submission_id")
  tasksTotal     Int?      @map("tasks_total")
  tasksCompleted Int?      @default(0) @map("tasks_completed")

  parent     Job?        @relation("JobHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Job[]       @relation("JobHierarchy")
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@index([parentId])
  @@index([submissionId])
  @@map("jobs")
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  action    String
  details   String?
  ipAddress String?   @map("ip_address")
  severity  String?   @default("INFO")
  timestamp DateTime? @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Appeal {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  reason       String
  status       String   @default("PENDING")
  adminComment String?  @map("admin_comment")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
  @@map("appeals")
}

model BulkSession {
  id                String   @id @default(uuid())
  title             String
  cloudLink         String   @map("cloud_link")
  lecturerId        String   @map("lecturer_id")
  status            String   @default("PENDING")
  totalFiles        Int?     @default(0) @map("total_files")
  processedFiles    Int?     @default(0) @map("processed_files")
  markingScheme     String?  @map("marking_scheme")
  goldStandardUrl   String?  @map("gold_standard_url")
  questionPaperUrl  String?  @map("question_paper_url")
  calibration       String?
  totalMarks        Int?     @default(100) @map("total_marks")
  successCount      Int?     @default(0) @map("success_count")
  unidentifiedCount Int?     @default(0) @map("unidentified_count")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  lecturer     User          @relation(fields: [lecturerId], references: [id])
  workSessions WorkSession[]

  @@index([lecturerId])
  @@index([status])
  @@map("bulk_sessions")
}

model StandardizedRubric {
  id                String   @id @default(uuid())
  lecturerId        String   @map("lecturer_id")
  examTitle         String   @map("exam_title")
  courseCode        String   @map("course_code")
  examDate          DateTime @map("exam_date")
  totalMarks        Float    @map("total_marks")
  numberOfQuestions Int      @map("number_of_questions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  lecturer     User             @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  questions    RubricQuestion[]
  workSessions WorkSession[]

  @@index([lecturerId])
  @@map("standardized_rubrics")
}

model RubricQuestion {
  id                   String @id @default(uuid())
  standardizedRubricId String @map("standardized_rubric_id")
  questionId           String @map("question_id")
  questionText         String @map("question_text")
  marksAllocated       Float  @map("marks_allocated")
  questionType         String @map("question_type")
  learningObjective    String @map("learning_objective")
  mcqOptions           String? @map("mcq_options")

  rubric          StandardizedRubric @relation(fields: [standardizedRubricId], references: [id], onDelete: Cascade)
  conceptUnits    ConceptUnit[]
  evaluationTiers EvaluationTier[]
  outOfScopeRules OutOfScopeRule[]
  penaltyRules    PenaltyRule[]

  @@index([standardizedRubricId])
  @@map("rubric_questions")
}

model ConceptUnit {
  id               String  @id @default(uuid())
  rubricQuestionId String  @map("rubric_question_id")
  conceptId        String  @map("concept_id")
  conceptText      String  @map("concept_text")
  marks            Float
  partialRule      String? @map("partial_rule")

  question RubricQuestion @relation(fields: [rubricQuestionId], references: [id], onDelete: Cascade)

  @@index([rubricQuestionId])
  @@map("concept_units")
}

model EvaluationTier {
  id               String @id @default(uuid())
  rubricQuestionId String @map("rubric_question_id")
  tierName         String @map("tier_name")
  description      String

  question RubricQuestion @relation(fields: [rubricQuestionId], references: [id], onDelete: Cascade)

  @@index([rubricQuestionId])
  @@map("evaluation_tiers")
}

model OutOfScopeRule {
  id               String @id @default(uuid())
  rubricQuestionId String @map("rubric_question_id")
  description      String
  maxMarks         Float  @map("max_marks")

  question RubricQuestion @relation(fields: [rubricQuestionId], references: [id], onDelete: Cascade)

  @@index([rubricQuestionId])
  @@map("out_of_scope_rules")
}

model PenaltyRule {
  id               String @id @default(uuid())
  rubricQuestionId String @map("rubric_question_id")
  description      String
  deduct           Float

  question RubricQuestion @relation(fields: [rubricQuestionId], references: [id], onDelete: Cascade)

  @@index([rubricQuestionId])
  @@map("penalty_rules")
}
