// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  // For local dev auth
  fullName  String?
  institution String?
  role      String   // 'lecturer', 'student'
  tier      String   @default("Lite") // 'Lite', 'Pro', 'X'
  quota     Int      @default(100) // Script quota
  used      Int      @default(0)   // Used scripts this month
  createdAt DateTime @default(now())
  deletedAt DateTime? // Soft delete

  classes   Classes[]
  quizzes   Quiz[]
  enrollments StudentEnrollment[]
  groups    GroupMember[]
  submissions Submission[]
}

// Renaming Classes to Session conceptually, but keeping table name for now to avoid drastic db reset if possible
// However, prompts requested unified naming. Let's stick to Classes for now but add features.
model Classes {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  lecturerId Int
  lecturer  User     @relation(fields: [lecturerId], references: [id])
  status    String   @default("ACTIVE") // DRAFT, ACTIVE, LOCKED, ARCHIVED
  semester  String?
  mode      String?  // ONLINE, OFFLINE, HYBRID

  // JSON list of student IDs is DEPRECATED. Use StudentEnrollment.
  students  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  quizzes   Quiz[]
  enrollments StudentEnrollment[]
  groupSets GroupSet[]
}

model StudentEnrollment {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Classes  @relation(fields: [classId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("ACTIVE") // ACTIVE, DROPPED

  joinedAt  DateTime @default(now())
  deletedAt DateTime? // Soft delete

  @@unique([userId, classId])
  @@index([classId])
}

model GroupSet {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Classes  @relation(fields: [classId], references: [id])
  name      String   // e.g. "Lab Partners"

  groups    Group[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model Group {
  id        Int      @id @default(autoincrement())
  setId     Int
  set       GroupSet @relation(fields: [setId], references: [id])
  name      String   // e.g. "Group A"

  members   GroupMember[]

  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

model Quiz {
  id        Int      @id @default(autoincrement())
  title     String
  code      String   @unique
  lecturerId Int
  lecturer  User     @relation(fields: [lecturerId], references: [id])
  classId   Int?
  class     Classes? @relation(fields: [classId], references: [id])

  deadline  DateTime?
  timer     Int?     // Minutes per student
  mode      String?  // 'ONLINE', 'UPLOAD', 'HYBRID'
  isUpload  Boolean  @default(true) // Legacy support
  rubric    String?  // Grading Rubric text
  gradingConfig String? // JSON: { strictness, language, etc. }

  // Production Hardening
  status    String   @default("DRAFT") // DRAFT, PUBLISHED, GRADING, RELEASED
  weight    Int      @default(0) // Basis points (e.g. 1000 = 10.00%)
  totalMarks Int?    // Immutable after publish

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  submissions Submission[]
}

model Submission {
  id        Int      @id @default(autoincrement())
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id])

  studentRegNo String // Legacy/Fallback
  studentName  String? // Legacy/Fallback

  // Link to real User if enrolled
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])

  filePath     String? // Path to PDF/Image
  ocrText      String? // Extracted Text
  status       String  @default("PENDING") // PENDING, SUBMITTED, PROCESSING, GRADED, FLAGGED, LATE, MISSING

  submittedAt  DateTime @default(now())

  // Group Hardening
  groupId      Int?     // If group work
  groupSnapshot String? // JSON string of group member IDs at time of submission

  score     Score?
  audit     AuditLog[]
  appeals   Appeals[]

  deletedAt DateTime? // Soft delete

  @@unique([quizId, userId]) // Constraint: One submission per student per quiz
  @@index([quizId])
}

model Score {
  id           Int        @id @default(autoincrement())
  submissionId Int        @unique
  submission   Submission @relation(fields: [submissionId], references: [id])

  totalMarks   Float
  breakdown    String     // JSON string of question breakdown
  remarks      String?
  confidence   Float?

  isOverridden Boolean    @default(false)

  gradedAt     DateTime   @default(now())

  @@index([submissionId])
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  action       String     // 'OCR', 'Grading', 'Flag'
  details      String?
  timestamp    DateTime   @default(now())
}

model Appeals {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  reason       String
  status       String     @default("OPEN")
  response     String?
}

// Helper model to track used codes if needed, though Quiz.code covers most.
model QuizCode {
  id     Int    @id @default(autoincrement())
  code   String @unique
  quizId Int
}
